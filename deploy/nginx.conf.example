# Include in an existing TLS server; install certificates and configure server_name separately.
# Data server: do not send these paths to the management port.
location ~ ^/(v1|backend-api/codex)/ {
    proxy_pass http://127.0.0.1:18080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $codexone_connection;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 130s;
    proxy_send_timeout 130s;
    client_max_body_size 8m;
}
# In http {}, define: map $http_upgrade $codexone_connection { default upgrade; '' close; }
# Separate management TLS server, matching CODEXONE_ADMIN_PUBLIC_ORIGIN:
# location / { proxy_pass http://127.0.0.1:18081; proxy_set_header Host $http_host;
#              proxy_http_version 1.1; proxy_buffering off; client_max_body_size 8k; }
