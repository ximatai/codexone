# Include in http {}. Install both snippets under /etc/nginx/snippets/.
# Replace names/certificate paths with your trusted TLS configuration.
map $http_upgrade $codexone_connection { default upgrade; '' close; }
server {
    listen 443 ssl;
    server_name data.example.invalid;
    ssl_certificate /etc/codexone/tls/data.crt;
    ssl_certificate_key /etc/codexone/tls/data.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Request URIs/errors can contain private identifiers or signed query strings.
    access_log off;
    error_log /dev/null crit;
    include /etc/nginx/snippets/codexone-data.conf;
}
server {
    listen 443 ssl;
    server_name admin.example.invalid;
    ssl_certificate /etc/codexone/tls/admin.crt;
    ssl_certificate_key /etc/codexone/tls/admin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    include /etc/nginx/snippets/codexone-admin.conf;
}
